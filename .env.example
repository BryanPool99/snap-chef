# Plantilla de variables de entorno - copia este archivo como .env y rellena los valores.
# Local: usa .env (gitignored). Vercel: configura estas variables en
# Settings > Environment Variables del proyecto.

# Clave de Google Gemini API (https://aistudio.google.com/apikey)
# Restringela por HTTP Referrer y con cuota diaria en Google AI Studio.
NG_APP_GEMINI_API_KEY=

# Modelo de Gemini a utilizar (ver modelos en https://ai.google.dev/gemini-api/docs/models)
NG_APP_GEMINI_MODEL=gemini-3.5-flash

# Modelos de respaldo separados por comas; si el principal está caído/saturado se prueban en cadena
NG_APP_GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
